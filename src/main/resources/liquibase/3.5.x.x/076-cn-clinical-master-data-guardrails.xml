<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

  <changeSet author="local-chinese-edition" id="3.5.0-076-cn-restrict-referring-site-to-master-data-update">
    <comment>Require China-profile order entry to select referring facilities from organization master data.</comment>
    <update schemaName="clinlims" tableName="site_information">
      <column name="value" value="true"/>
      <column name="lastupdated" valueComputed="now()"/>
      <where>name = 'restrictFreeTextRefSiteEntry'</where>
    </update>
  </changeSet>

  <changeSet author="local-chinese-edition" id="3.5.0-076-cn-restrict-referring-site-to-master-data-insert">
    <preConditions onFail="MARK_RAN">
      <sqlCheck expectedResult="0">
        SELECT COUNT(*) FROM clinlims.site_information WHERE name = 'restrictFreeTextRefSiteEntry'
      </sqlCheck>
    </preConditions>
    <comment>Seed the organization-master-data guard for older China installations.</comment>
    <insert schemaName="clinlims" tableName="site_information">
      <column name="id" valueSequenceNext="site_information_seq"/>
      <column name="name" value="restrictFreeTextRefSiteEntry"/>
      <column name="lastupdated" valueComputed="now()"/>
      <column name="value" value="true"/>
      <column name="encrypted" valueBoolean="false"/>
      <column name="domain_id" valueComputed="(SELECT id FROM clinlims.site_information_domain WHERE name = 'sampleEntryConfig')"/>
      <column name="value_type" value="boolean"/>
      <column name="group" valueNumeric="0"/>
    </insert>
  </changeSet>

</databaseChangeLog>
